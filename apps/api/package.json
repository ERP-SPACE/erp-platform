{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "@erp/documents": "workspace:*",
    "@erp/domain": "workspace:*",
    "@erp/labels": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "better-auth": "1.7.12",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}

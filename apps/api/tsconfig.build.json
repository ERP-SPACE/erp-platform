{
  "extends": "@erp/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Unchanged files are not re-emitted, so `pnpm dev` doesn't restart the API on startup.
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}

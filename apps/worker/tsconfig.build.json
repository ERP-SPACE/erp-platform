{
  "extends": "@erp/config/tsconfig.base.json",
  "compilerOptions": {
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    // Unchanged files are not re-emitted, so `pnpm dev` doesn't restart the worker on startup.
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src"]
}

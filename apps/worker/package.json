{
  "name": "@erp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "@erp/labels": "workspace:*",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}

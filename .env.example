# Copy is generated by `pnpm setup:local` (fills the secrets below). Never commit .env.
NODE_ENV=development
TZ=Asia/Kolkata

# Postgres (infra/docker/docker-compose.yml)
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5433/erp
DATABASE_OWNER_URL=postgres://erp_owner:erp_owner_dev@localhost:5433/erp

# Redis
REDIS_URL=redis://localhost:6380

# Object storage (MinIO locally, S3 later)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=erp-local
S3_ACCESS_KEY=erp-minio
S3_SECRET_KEY=erp-minio-dev

# Email (Mailpit locally)
SMTP_URL=smtp://localhost:1025

# API
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Auth (filled by setup:local)
AUTH_SECRET=
STEP_UP_SECONDS=300

# Seed owner account (filled by setup:local; change after first login)
SEED_OWNER_EMAIL=owner@erp.local
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=

# Optional dev-only sign-in created by pnpm db:seed:demo (Admin + Sales Manager)
# DEMO_USER_EMAIL=demo.manager@erp.local
# DEMO_USER_PASSWORD=

# E-invoicing (ADR-0011). Leave the NIC_* values empty to use the offline IRN simulator.
# API_JOBS=true
# QUEUE_PREFIX=bull
# PDF_RENDERER=worker
# NIC_BASE_URL=https://einv-apisandbox.nic.in
# NIC_CLIENT_ID=
# NIC_CLIENT_SECRET=
# NIC_USERNAME=
# NIC_PASSWORD=
# NIC_GSTIN=
# NIC_PUBLIC_KEY=

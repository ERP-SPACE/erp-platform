{
  "name": "@erp/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure business logic: money, rounding, FY, numbering, state machines. No I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}

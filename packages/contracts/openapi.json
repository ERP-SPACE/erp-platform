  "info": {
    "title": "Paper Trading ERP API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "erp.session_token"
      }
    },
    "schemas": {
      "StepUpDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "roleCodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "roleCodes"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "active": {
            "type": "boolean"
          },
          "roleCodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissionCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "settings.view",
                "settings.update",
                "settings.company.update",
                "settings.series.view",
                "settings.series.update",
                "users.view",
                "users.manage",
                "roles.manage",
                "audit.view"
              ]
            }
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "required": [
          "permissionCodes",
          "version"
        ]
      },
      "UpdateSettingDto": {
        "type": "object",
        "properties": {
          "value": {},
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "value",
          "version"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "tradeName": {
            "type": "string",
            "maxLength": 160,
            "nullable": true
          },
          "gstin": {
            "type": "string",
            "minLength": 15,
            "maxLength": 15,
            "nullable": true
          },
          "stateCode": {
            "type": "string",
            "pattern": "^\\d{2}$"
          },
          "pan": {
            "type": "string",
            "pattern": "^[A-Z]{5}\\d{4}[A-Z]$",
            "nullable": true
          },
          "address": {
            "type": "object",
            "properties": {
              "line1": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "line2": {
                "type": "string",
                "maxLength": 120
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "pincode": {
                "type": "string",
                "pattern": "^\\d{6}$"
              }
            },
            "required": [
              "line1",
              "city",
              "state",
              "pincode"
            ]
          },
          "bank": {
            "type": "object",
            "properties": {
              "bankName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "accountName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "accountNumber": {
                "type": "string",
                "pattern": "^\\d{6,20}$"
              },
              "ifsc": {
                "type": "string",
                "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$"
              },
              "branch": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "bankName",
              "accountName",
              "accountNumber",
              "ifsc"
            ],
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "nullable": true
          },
          "signatoryName": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "required": [
          "legalName",
          "tradeName",
          "gstin",
          "stateCode",
          "pan",
          "address",
          "bank",
          "email",
          "phone",
          "signatoryName",
          "version"
        ]
      },
      "UpdateSeriesDto": {
        "type": "object",
        "properties": {
          "prefixTemplate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "padding": {
            "type": "integer",
            "minimum": 3,
            "maximum": 8
          },
          "resetOnFy": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "required": [
          "prefixTemplate",
          "padding",
          "resetOnFy",
          "version"
        ]
      }
    }
  }
}
